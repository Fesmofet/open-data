{
  "name": "chain-indexer",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/chain-indexer/src",
  "projectType": "application",
  "implicitDependencies": [
    "hive-processor",
    "hive-engine-processor"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "args": [
          "--config-node-env=production"
        ],
        "cwd": "apps/chain-indexer"
      },
      "configurations": {
        "development": {
          "args": [
            "--config-node-env=development"
          ]
        }
      }
    },
    "docker-image": {
      "dependsOn": [
        "build"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "echo CI builds the Docker image for this app"
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [
        "build"
      ],
      "options": {
        "buildTarget": "chain-indexer:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "chain-indexer:build:development"
        },
        "production": {
          "buildTarget": "chain-indexer:build:production"
        }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.app.json",
        "cwd": "apps/chain-indexer"
      }
    }
  },
  "tags": []
}
