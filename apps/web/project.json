{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web",
  "projectType": "application",
  "tags": [],
  "implicitDependencies": [
    "hive-broadcast",
    "notifications-contract",
    "notifications-messages"
  ],
  "// targets": "to see all targets run: nx show project web --web",
  "targets": {
    "dev": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/web",
        "command": "next dev --webpack"
      }
    },
    "dev-webpack": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/web",
        "command": "next dev --webpack"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "apps/web"
      }
    },
    "verify-production-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/verify-web-production-build.cjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "docker-image": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "echo CI builds the Docker image for this app"
      }
    }
  }
}
