# =============================================================================
# notifications — copy to `apps/notifications/.env` (gitignored).
# JWT must match auth-api when verifying access tokens.
#
# Full stack `docker compose` overrides PORT/JWT_SECRET — see repo root `.env.example`.
# =============================================================================
PORT=7200
JWT_SECRET=change-me-min-16-chars-for-dev
REDIS_URI=redis://localhost:6379
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=odl
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_POOL_MAX=25
SUBSCRIPTION_TTL_SECONDS=300
WS_PING_INTERVAL_MS=30000
WS_PING_TIMEOUT_MS=10000
WS_MAX_CONNECTIONS_PER_USER=5

# Telegram channel (optional — omit token to disable user bot)
# TELEGRAM_BOT_TOKEN=
# WEB_PUBLIC_ORIGIN=http://localhost:3000
# TELEGRAM_POLL_TIMEOUT_SEC=10
# TELEGRAM_POLL_INTERVAL_MS=300
# TELEGRAM_SEND_RATE_PER_SEC=25

# Ops / system alerts bot (optional — omit token to disable)
# TELEGRAM_OPS_BOT_TOKEN=

# Redis stream consumer name (stable across restarts; default notifications-1)
# NOTIFICATIONS_CONSUMER_NAME=notifications-1

# Live /status health check (Hive Engine RPC nodes; comma-separated overrides)
# HIVE_ENGINE_NODES=
# SYSTEM_HEALTH_BLOCK_LAG_BUFFER=100
