# =============================================================================
# scheduler — copy to `.env` next to this file.
#
# Local `nx serve`: `localhost` below. Full stack `docker compose` overrides
# hostnames for the Docker network — see repo root `.env.example`.
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=odl
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL_MAX=5

REDIS_URI=redis://localhost:6379

SCHEDULER_WORKER_INTERVAL_MS=2000
SCHEDULER_WORKER_BATCH_SIZE=5
SCHEDULER_GLOBAL_ENABLED=true
# SCHEDULER_DISABLED_JOBS=waiv-post-reconcile,post-rewards-finalize
# Reclaim `claimed` queue rows / fail ancient incomplete runs (seconds)
# SCHEDULER_STALE_CLAIM_SEC=600
# SCHEDULER_STALE_RUN_SEC=21600

# Hive Engine JSON-RPC (reconcile job)
# HIVE_ENGINE_NODES=https://api.hive-engine.com/rpc,https://herpc.dtools.dev

# Hive Engine History API (post-rewards-finalize cashout fallback)
# Comma-separated; omit for built-in defaults:
# https://accounts.hive-engine.com, https://history.hive-engine.com, https://v6-he.atexoras.com:8443
# HIVE_ENGINE_HISTORY_NODES=https://accounts.hive-engine.com,https://history.hive-engine.com
# HIVE_ENGINE_HISTORY_CACHE_PREFIX=scheduler_hive_engine_history
# HIVE_ENGINE_HISTORY_MAX_RESPONSE_TIME_MS=8000
# HIVE_ENGINE_HISTORY_URL_ROTATION_DB=0

# Post rewards — must match chain-indexer POST_REWARDS_FINALIZE_DELAY_SEC
# POST_REWARDS_FINALIZE_DELAY_SEC=900
# POST_REWARDS_FINALIZE_BATCH_SIZE=50
# POST_REWARD_RECONCILE_BATCH_SIZE=50
# SYSTEM_HEALTH_BLOCK_LAG_BUFFER=100

# Site canonical (other scheduler jobs)
# SITE_CANONICAL_FALLBACK_ORIGIN=https://example.com
